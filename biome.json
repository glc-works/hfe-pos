{
  "$schema": "https://biomejs.dev/schemas/2.5.10/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": true,
    "includes": ["src/**/*.ts", "src/**/*.tsx"]
  },
  "linter": {
    "enabled": true,
    "rules": {
      "a11y": {
        "recommended": false
      },
      "complexity": {
        "recommended": false
      },
      "style": {
        "recommended": false,
        "useConst": "error"
      },
      "suspicious": {
        "recommended": false,
        "noDoubleEquals": "error",
        "noDebugger": "error",
        "noDuplicateJsxProps": "error"
      },
      "correctness": {
        "recommended": false,
        "noUnreachable": "error",
        "noUnreachableSuper": "error"
      }
    }
  }
}
