{
  "name": "hfe-pos",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "biome lint src",
    "lint:secrets": "secretlint \"src/**\"",
    "lint:spelling": "cspell \"src/**/*.{ts,tsx}\"",
    "check:deadcode": "knip",
    "check:size": "size-limit",
    "preview": "vite preview",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test e2e/flagship-one-transaction-one-truth.spec.ts",
    "test:e2e:ui": "playwright test --ui",
    "test:visual": "playwright test e2e/visual-regression.spec.ts",
    "clean:test": "rm -rf test-results playwright-report blob-report coverage",
    "typecheck": "tsc --noEmit",
    "guard:modularity": "python3 scripts/check-modularity.py",
    "guard:connector": "python3 scripts/validate-connector.py",
    "prepare": "lefthook install",
    "ci": "./scripts/ci-local.sh"
  },
  "dependencies": {
    "@hfe/sdk": "file:../headless-company-books/packages/hfe-sdk",
    "@radix-ui/react-dialog": "^1.1.2",
    "@radix-ui/react-dropdown-menu": "^2.1.2",
    "@radix-ui/react-label": "^2.1.0",
    "@radix-ui/react-popover": "^1.1.2",
    "@radix-ui/react-select": "^2.1.2",
    "@radix-ui/react-separator": "^1.1.0",
    "@radix-ui/react-slot": "^1.1.0",
    "@radix-ui/react-tabs": "^1.1.1",
    "@radix-ui/react-toast": "^1.2.2",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "lucide-react": "^0.453.0",
    "react": "^18.3.1",
    "react-aria": "^3.35.0",
    "react-aria-components": "^1.4.0",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.5.4",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.10",
    "@chromatic-com/storybook": "^3.2.2",
    "@playwright/test": "^1.62.1",
    "@secretlint/secretlint-rule-preset-recommend": "^13.0.4",
    "@size-limit/preset-app": "^13.0.3",
    "@storybook/addon-essentials": "^8.4.2",
    "@storybook/addon-interactions": "^8.4.2",
    "@storybook/addon-onboarding": "^8.4.2",
    "@storybook/blocks": "^8.4.2",
    "@storybook/react": "^8.4.2",
    "@storybook/react-vite": "^8.4.2",
    "@storybook/test": "^8.4.2",
    "@types/node": "^22.8.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "@vitest/coverage-v8": "^2.1.9",
    "autoprefixer": "^10.4.20",
    "cspell": "^10.0.1",
    "knip": "^6.32.2",
    "lefthook": "^2.1.10",
    "playwright": "^1.62.1",
    "postcss": "^8.4.47",
    "secretlint": "^13.0.4",
    "size-limit": "^13.0.3",
    "storybook": "^8.4.2",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vitest": "^2.1.8"
  }
}
