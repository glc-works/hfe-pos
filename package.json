{
  "name": "hfe-pos",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.18.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "dev": "vite",
    "demo:dev": "VITE_ENABLE_LOCAL_DEMO=true vite",
    "build:sdk": "tsc --project packages/hfe-sdk/tsconfig.json",
    "build": "npm run build:sdk && vite build",
    "build:pos-landing": "npm run build --prefix packages/storefront-astro",
    "build:all": "npm run build && npm run build:pos-landing",
    "lint": "biome lint src",
    "lint:secrets": "secretlint \"**/*\"",
    "lint:spelling": "cspell \"src/**/*.{ts,tsx}\"",
    "guard:hygiene": "python3 scripts/check-repo-hygiene.py",
    "guard:modularity": "python3 scripts/check-modularity.py",
    "guard:connector": "python3 scripts/validate-connector.py",
    "guard:first-party-build": "node scripts/validate-first-party-build-env.mjs",
    "check:deadcode": "knip",
    "check:size": "size-limit",
    "check:truth-boundary": "node scripts/check-truth-boundary.mjs",
    "preview": "vite preview",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test && npm run rotate:test",
    "test:e2e:ui": "playwright test --ui",
    "test:flagship": "playwright test e2e/flagship-one-transaction-one-truth.spec.ts && npm run rotate:test",
    "test:connected-auth": "VITE_HFE_RUNTIME_MODE=connected VITE_TOGROW_URL=/id VITE_TOGROW_SOCIAL_PROVIDERS=google,apple VITE_HFE_CORE_URL=http://localhost:8080 VITE_HFE_COMPANY_BOOK_URL=http://localhost:8080 VITE_TOGROW_CLIENT_ID=test-client VITE_HFE_BRANCH_ID=branch-test VITE_TOGROW_ORGANIZATION_ID=00000000-0000-4000-8000-000000000001 VITE_HFE_BOOK_ID=00000000-0000-4000-8000-000000000002 VITE_HFE_AUTHORITY_CONTEXT_ID=00000000-0000-4000-8000-000000000003 VITE_HFE_CASHIER_SESSION_ID=00000000-0000-4000-8000-000000000004 VITE_HFE_FLAGSHIP_PRODUCT_ID=00000000-0000-4000-8000-000000000005 sh -c 'npm run build && playwright test e2e/connected-auth-entry.spec.ts' && npm run rotate:test",
    "test:smoke": "playwright test e2e/smoke-ci.spec.ts",
    "test:demo": "VITE_ENABLE_LOCAL_DEMO=true sh -c 'npm run build && playwright test e2e/demo-entry-contract.spec.ts'",
    "test:visual": "playwright test e2e/visual-regression.spec.ts && npm run rotate:test",
    "test:contrast": "playwright test e2e/theme-contrast-audit.spec.ts && npm run rotate:test",
    "demo:communications:start": "node scripts/demo-communications.mjs start",
    "demo:communications:reset": "node scripts/demo-communications.mjs reset",
    "demo:communications:test": "node scripts/demo-communications.mjs test",
    "demo:communications:stop": "node scripts/demo-communications.mjs stop",
    "test:demo-communications": "sh -c 'trap \"npm run demo:communications:stop\" EXIT; npm run demo:communications:start && npm run demo:communications:test && playwright test --config playwright.communications.config.ts'",
    "test:all": "./scripts/ci-local.sh && npm run test:e2e",
    "rotate:test": "python3 scripts/rotate-test-results.py",
    "clean:test": "rm -rf test-results playwright-report blob-report coverage",
    "typecheck": "tsc --noEmit",
    "prepare": "npm run build:sdk && lefthook install",
    "ci": "./scripts/ci-local.sh"
  },
  "dependencies": {
    "@hfe/sdk": "file:packages/hfe-sdk",
    "@radix-ui/react-dialog": "^1.1.2",
    "@radix-ui/react-dropdown-menu": "^2.1.2",
    "@radix-ui/react-label": "^2.1.0",
    "@radix-ui/react-popover": "^1.1.2",
    "@radix-ui/react-select": "^2.1.2",
    "@radix-ui/react-separator": "^1.1.0",
    "@radix-ui/react-slot": "^1.1.0",
    "@radix-ui/react-tabs": "^1.1.1",
    "@radix-ui/react-toast": "^1.2.2",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "lucide-react": "^0.577.0",
    "react": "^18.3.1",
    "react-aria": "^3.35.0",
    "react-aria-components": "^1.4.0",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.5.4",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@biomejs/biome": "^2.5.10",
    "@chromatic-com/storybook": "^3.2.2",
    "@playwright/test": "^1.62.1",
    "@secretlint/secretlint-rule-preset-recommend": "^13.0.4",
    "@size-limit/preset-app": "^13.0.3",
    "@storybook/addon-essentials": "^8.4.2",
    "@storybook/addon-interactions": "^8.4.2",
    "@storybook/addon-onboarding": "^8.4.2",
    "@storybook/blocks": "^8.4.2",
    "@storybook/react": "^8.4.2",
    "@storybook/react-vite": "^8.4.2",
    "@storybook/test": "^8.4.2",
    "@types/node": "^22.8.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "@vitest/coverage-v8": "^2.1.9",
    "autoprefixer": "^10.4.20",
    "cspell": "^10.0.1",
    "knip": "^6.32.2",
    "lefthook": "^2.1.10",
    "playwright": "^1.62.1",
    "postcss": "^8.4.47",
    "secretlint": "^13.0.4",
    "size-limit": "^13.0.3",
    "storybook": "^8.4.2",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vitest": "^2.1.8"
  }
}
