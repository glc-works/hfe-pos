---
// --- BOARD.HFEIT.COM ROOT DIRECTORY & ECOSYSTEM SHOWCASE ---
import MerchantStorefrontLayout from '../layouts/MerchantStorefrontLayout.astro';
---

<MerchantStorefrontLayout
  title="BOARD.Hfeit • Direktori Etalase Merchant & Menu Digital Terverifikasi"
  description="Temukan kafe, restoran, butik, dan layanan terverifikasi dalam ekosistem HFE IT."
>
  <div class="text-center py-12 space-y-4">
    <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-amber-500/20 border border-amber-500/30 text-amber-400 text-xs font-mono font-bold">
      ⚡ BOARD.Hfeit — Be Found
    </div>
    <h1 class="text-3xl sm:text-5xl font-extrabold text-white tracking-tight">
      Satu Transaksi. <span class="text-amber-400">Satu Kebenaran.</span>
    </h1>
    <p class="text-sm sm:text-base text-slate-300 max-w-xl mx-auto leading-relaxed">
      Etalase publik terdesentralisasi berbasis Cloudflare Edge. Kecepatan 100/100 Core Web Vitals, Schema.org SEO, dan integrasi langsung ke kasir POS.
    </p>

    <!-- Merchant Showcase Card -->
    <div class="pt-8 max-w-md mx-auto text-left">
      <a
        href="/senopati-kopitiam"
        class="block p-5 rounded-3xl border border-slate-800 bg-slate-900/80 hover:border-amber-500/50 transition-all shadow-2xl group"
      >
        <div class="flex items-center gap-3">
          <div class="w-12 h-12 rounded-2xl bg-amber-500/20 border border-amber-500/40 flex items-center justify-center text-2xl group-hover:scale-110 transition-transform">
            ☕
          </div>
          <div>
            <div class="flex items-center gap-1.5">
              <h3 class="text-base font-bold text-white group-hover:text-amber-400 transition-colors">Kopitiam Senopati HQ</h3>
              <span class="text-[10px] text-emerald-400 font-mono">🟢 Buka</span>
            </div>
            <p class="text-xs text-slate-400">Senopati, Jakarta Selatan • 4.9 ⭐</p>
          </div>
        </div>

        <p class="text-xs text-slate-300 mt-3 line-clamp-2">
          Koleksi single origin nusantara terbaik disangrai segar setiap minggu di Senopati.
        </p>

        <div class="mt-4 pt-3 border-t border-slate-800 flex items-center justify-between text-xs font-mono text-amber-400">
          <span>Kunjungi Etalase Resmi</span>
          <span class="group-hover:translate-x-1 transition-transform">➔</span>
        </div>
      </a>
    </div>
  </div>
</MerchantStorefrontLayout>
