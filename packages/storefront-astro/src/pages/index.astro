---
import PosLayout from '../layouts/PosLayout.astro'
import PosNavbar from '../components/pos/PosNavbar.astro'
import PosHeroSection from '../components/pos/PosHeroSection.astro'
import PosBentoGrid from '../components/pos/PosBentoGrid.astro'
import PosEarlyAccessSection from '../components/pos/PosEarlyAccessSection.astro'
import PosBottomCta from '../components/pos/PosBottomCta.astro'
import PosFooter from '../components/pos/PosFooter.astro'
---

<PosLayout
  title="POS.Hfeit — Kasir Kilat. Siap di Jam Paling Sibuk."
  description="Sistem kasir workstation profesional dengan respon sentuh sub-16ms, KDS dapur terpisah, denah meja, dan ketahanan offline 100%."
>
  <main class="w-full">
    <PosHeroSection>
      <PosNavbar slot="navbar" />
    </PosHeroSection>

    <PosBentoGrid />

    <PosEarlyAccessSection />

    <PosBottomCta />
  </main>

  <PosFooter />
</PosLayout>
