---
// --- ROOT LAYOUT FOR BOARD.HFEIT.COM STOREFRONT ---
import OpenGraphMeta from '../components/seo/OpenGraphMeta.astro';

interface Props {
  title: string;
  description?: string;
  image?: string;
  canonicalUrl?: string;
}

const {
  title,
  description = 'Etalase Publik Resmi & Menu Digital terverifikasi HFE IT.',
  image = 'https://images.unsplash.com/photo-1501339847302-ac426a4a7cbb?w=1200&q=80',
  canonicalUrl = 'https://board.hfeit.com',
} = Astro.props;
---

<!doctype html>
<html lang="id" class="dark scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=JetBrains+Mono:wght@500;700&display=swap"
      rel="stylesheet"
    />
    <OpenGraphMeta title={title} description={description} image={image} url={canonicalUrl} />
    <slot name="head" />
  </head>
  <body class="bg-slate-950 text-slate-100 font-sans min-h-screen antialiased selection:bg-amber-500 selection:text-slate-950 pb-28">
    <!-- Preview Sandbox Watermark Banner (Option A) -->
    <div class="sticky top-0 z-50 bg-amber-500/10 border-b border-amber-500/30 backdrop-blur-md px-4 py-1.5 text-center text-xs font-mono text-amber-300 flex items-center justify-center gap-2">
      <span class="size-2 rounded-full bg-amber-400 animate-pulse"></span>
      <span class="font-bold">🟡 PREVIEW SANDBOX &bull; DATA SIMULASI BENCHMARK</span>
      <span class="hidden sm:inline text-[10px] text-amber-400/70 border-l border-amber-500/30 pl-2">Hfe Core Pilot Environment</span>
    </div>

    <div class="max-w-4xl mx-auto px-3 sm:px-6 pt-3 sm:pt-6 space-y-6">
      <slot />
    </div>

    <!-- 🚀 Merchant Onboarding CTA (pos.hfeit.com) -->
    <section class="max-w-4xl mx-auto px-3 sm:px-6 pt-8">
      <div class="p-5 sm:p-6 rounded-3xl bg-gradient-to-r from-amber-500/10 via-orange-500/10 to-amber-500/10 border border-amber-500/30 text-center space-y-3">
        <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-amber-500/20 text-amber-400 text-[11px] font-bold">
          <span>✨ Buka Etalase & Sistem Kasir untuk Bisnismu</span>
        </div>
        <h4 class="text-base sm:text-lg font-black text-white">
          Ingin punya website etalase publik dan POS terintegrasi seperti ini?
        </h4>
        <p class="text-xs text-slate-400 max-w-md mx-auto">
          Kelola pesanan QR, kasir meja, pembayaran QRIS, hingga pembukuan otomatis Hfe CORE dalam satu sistem.
        </p>
        <div class="pt-1">
          <a
            href="https://pos.hfeit.com"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl bg-amber-500 hover:bg-amber-400 text-slate-950 font-bold text-xs shadow-lg shadow-amber-500/20 transition-all active:scale-95"
          >
            <span>Daftar Merchant Baru di POS.Hfeit</span>
            <span>➔</span>
          </a>
        </div>
      </div>
    </section>

    <!-- Ecosystem Footer -->
    <footer class="max-w-4xl mx-auto px-3 sm:px-6 pt-12 pb-6 text-center text-xs text-slate-500 space-y-2">
      <p class="font-mono">⚡ Powered by <span class="text-slate-300 font-bold">HFE IT CORE</span> • One Transaction. One Truth.</p>
      <p class="text-[11px] text-slate-600">Sovereign Cloudflare Edge Infrastructure • 100% Core Web Vitals</p>
    </footer>
  </body>
</html>

<style is:global>
  body {
    font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    overscroll-behavior-y: none;
    -webkit-tap-highlight-color: transparent;
  }
  .font-mono {
    font-family: 'JetBrains Mono', monospace;
    font-variant-numeric: tabular-nums;
  }
</style>
