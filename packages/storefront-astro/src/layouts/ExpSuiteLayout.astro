---
import { ClientRouter } from 'astro:transitions'
import LanguageSwitcher from '../components/common/LanguageSwitcher.astro'

interface Props {
  title: string
  description: string
  currentLang?: 'id' | 'en'
}

const {
  title = 'EXP.Hfeit — The Unified Commerce & Experience Suite',
  description = 'Satu Sistem Cerdas untuk Semua Urusan Bisnis Anda. Kasir Kilat, Order QR, Loyalitas Member & Pembukuan Otomatis.',
  currentLang = 'id'
} = Astro.props
---

<!doctype html>
<html lang={currentLang} class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <!-- Primary Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />

    <!-- Open Graph / Facebook / WhatsApp -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={Astro.url} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="https://images.unsplash.com/photo-1554118811-1e0d58224f24?w=1200&q=80" />

    <!-- Plus Jakarta Sans & JetBrains Mono Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;600;700&family=Plus+Jakarta+Sans:wght@400;500;600;700;800;900&display=swap"
      rel="stylesheet"
    />

    <!-- Astro 7.2 View Transitions -->
    <ClientRouter />
  </head>
  <body class="bg-[#FAFAFC] text-slate-900 font-sans antialiased min-h-screen selection:bg-amber-500/20 selection:text-amber-900 bg-[linear-gradient(to_right,#e2e8f0_1px,transparent_1px),linear-gradient(to_bottom,#e2e8f0_1px,transparent_1px)] bg-[size:4rem_4rem]">
    <!-- Top Sticky Header (Cloudflare Light Glassmorphism) -->
    <header class="sticky top-0 z-50 w-full border-b border-slate-200/80 bg-white/80 backdrop-blur-md shadow-xs">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 h-16 flex items-center justify-between">
        <!-- Brand Identity -->
        <a href={currentLang === 'en' ? '/exp/en' : '/exp'} class="flex items-center gap-2.5 group">
          <div class="w-8 h-8 rounded-lg bg-gradient-to-tr from-amber-500 to-orange-500 flex items-center justify-center font-extrabold text-slate-950 font-mono text-base shadow-sm group-hover:scale-105 transition-transform">
            E
          </div>
          <div class="flex items-baseline gap-1">
            <span class="font-extrabold tracking-tight text-lg text-slate-950">EXP</span>
            <span class="font-mono text-xs font-bold text-amber-600">.Hfeit</span>
          </div>
        </a>

        <!-- Desktop Navigation Links -->
        <nav class="hidden md:flex items-center gap-6 text-xs font-semibold text-slate-600">
          <a href="#quintet" class="hover:text-slate-950 transition-colors">5 Produk Inti</a>
          <a href="#solutions" class="hover:text-slate-950 transition-colors">Solusi Masalah</a>
          <a href="#workflow" class="hover:text-slate-950 transition-colors">Alur Transaksi</a>
          <a href="#industries" class="hover:text-slate-950 transition-colors">Multi-Industri</a>
        </nav>

        <!-- Right Action Zone -->
        <div class="flex items-center gap-3">
          <LanguageSwitcher currentLang={currentLang} />
          <a
            href="/onboarding"
            class="px-4 py-2 rounded-lg bg-gradient-to-r from-amber-500 via-orange-500 to-amber-600 hover:from-amber-400 hover:to-orange-400 active:scale-95 text-slate-950 font-extrabold text-xs shadow-xs transition-all duration-150 flex items-center gap-1.5"
          >
            <span>Daftar Gratis</span>
            <span>➔</span>
          </a>
        </div>
      </div>
    </header>

    <!-- Main Content Slot -->
    <main class="relative overflow-hidden">
      <slot />
    </main>

    <!-- Footer (Cloudflare Light Enterprise Grid) -->
    <footer class="border-t border-slate-200 bg-white py-12 px-4 sm:px-6 text-center text-xs text-slate-500 font-mono">
      <div class="max-w-7xl mx-auto flex flex-col sm:flex-row items-center justify-between gap-4">
        <div>
          © 2026 HFE IT. All rights reserved. • EXP.Hfeit Merchant Experience Layer
        </div>
        <div class="flex items-center gap-4 text-slate-600 font-sans font-semibold">
          <a href="/exp" class="hover:text-slate-950">EXP.Hfeit</a>
          <a href="/board" class="hover:text-slate-950">BOARD.Hfeit</a>
          <a href="/pos" class="hover:text-slate-950">POS.Hfeit</a>
          <a href="/onboarding" class="text-amber-600 hover:underline">Daftar Usaha ➔</a>
        </div>
      </div>
    </footer>
  </body>
</html>
