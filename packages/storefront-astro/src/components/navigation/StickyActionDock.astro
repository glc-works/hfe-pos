---
// --- MODUL 7: DYNAMIC FLOATING ISLAND ACTION DOCK (STICKY BOTTOM JEMPOL) ---
import { buildOrderHandoffUrl } from '../../lib/channelGovernance';

interface Props {
  merchantSlug: string;
  channels: {
    enableDineInQr: boolean;
    enableTakeaway: boolean;
    enableOnlineDelivery: boolean;
    enableTableReservation: boolean;
  };
}

const { merchantSlug, channels } = Astro.props;

const dineInUrl = buildOrderHandoffUrl({ merchantSlug, mode: 'dine_in' });
const takeawayUrl = buildOrderHandoffUrl({ merchantSlug, mode: 'takeaway' });
const deliveryUrl = buildOrderHandoffUrl({ merchantSlug, mode: 'delivery' });
---

<div class="fixed bottom-3 left-3 right-3 sm:left-auto sm:right-6 sm:bottom-6 z-50 max-w-lg mx-auto">
  <div class="p-1.5 rounded-2xl bg-slate-900/90 backdrop-blur-2xl border border-slate-700/60 shadow-2xl flex items-center justify-between gap-1.5">
    {channels.enableDineInQr && (
      <a
        href={dineInUrl}
        class="flex-1 py-2.5 px-3 rounded-xl bg-amber-500 hover:bg-amber-400 active:scale-95 text-slate-950 font-bold text-xs text-center transition-all shadow-md truncate"
      >
        <span>📱 Pesan Meja</span>
      </a>
    )}

    {channels.enableTakeaway && (
      <a
        href={takeawayUrl}
        class="flex-1 py-2.5 px-3 rounded-xl bg-slate-800 hover:bg-slate-700 active:scale-95 text-slate-100 font-bold text-xs text-center transition-all border border-slate-700 truncate"
      >
        <span>🛍️ Bungkus</span>
      </a>
    )}

    {channels.enableOnlineDelivery && (
      <a
        href={deliveryUrl}
        class="flex-1 py-2.5 px-3 rounded-xl bg-emerald-600 hover:bg-emerald-500 active:scale-95 text-white font-bold text-xs text-center transition-all shadow-md truncate"
      >
        <span>🛵 Antar</span>
      </a>
    )}
  </div>
</div>
