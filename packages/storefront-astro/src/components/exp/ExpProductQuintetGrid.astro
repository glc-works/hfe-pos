---
import type { ProductFeatureInfo } from '../../i18n/translations'

interface Props {
  t: {
    sectionBadge: string
    sectionTitle: string
    sectionSubtitle: string
    pos: ProductFeatureInfo
    book: ProductFeatureInfo
    order: ProductFeatureInfo
    board: ProductFeatureInfo
    card: ProductFeatureInfo
  }
}

const { t } = Astro.props
---

<section id="quintet" class="py-24 px-4 sm:px-6 max-w-7xl mx-auto border-t border-slate-200">
  <!-- Section Header -->
  <div class="text-center max-w-3xl mx-auto mb-16">
    <span class="text-xs font-mono font-bold text-amber-600 uppercase tracking-widest mb-3 block">
      {t.sectionBadge}
    </span>
    <h2 class="text-3xl sm:text-5xl font-extrabold text-slate-950 tracking-tight mb-4">
      {t.sectionTitle}
    </h2>
    <p class="text-base sm:text-lg text-slate-600 leading-relaxed font-normal">
      {t.sectionSubtitle}
    </p>
  </div>

  <!-- 5-Product Bento Grid (7:5 Hero Duo + 4:4:4 Channel Trio) -->
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-6">
    <!-- 1. POS.Hfeit (7 Cols - Hero Workstation) -->
    <div class="lg:col-span-7 rounded-2xl border border-amber-200 bg-gradient-to-b from-amber-50/40 via-white to-white p-6 sm:p-8 shadow-sm hover:shadow-md hover:border-amber-300 transition-all duration-200 flex flex-col justify-between">
      <div>
        <div class="flex items-center justify-between mb-4">
          <div class="flex items-center gap-2">
            <span class="px-2.5 py-1 rounded-md text-xs font-mono font-bold bg-amber-500 text-slate-950 shadow-xs">
              01 • POS
            </span>
            <span class="text-xs font-mono font-bold text-amber-800">{t.pos.tagline}</span>
          </div>
          <span class="text-xs font-mono font-bold text-emerald-700 bg-emerald-50 px-2.5 py-0.5 rounded-full border border-emerald-200">
            ⚡ &lt;16ms Touch Latency
          </span>
        </div>
        <h3 class="text-2xl font-extrabold text-slate-950 mb-2">{t.pos.name}</h3>
        <p class="text-xs sm:text-sm text-slate-600 mb-6 leading-relaxed font-medium">{t.pos.role}</p>

        <!-- Mini POS Workstation Mockup Widget -->
        <div class="rounded-xl border border-slate-200 bg-slate-50 p-4 mb-6 space-y-3">
          <div class="flex items-center justify-between text-xs font-mono">
            <span class="font-bold text-slate-700">Terminal Kasir &amp; KDS Dapur</span>
            <span class="text-amber-700 font-bold">Meja OUT-04 (Terisi)</span>
          </div>
          <div class="grid grid-cols-3 gap-2 text-xs">
            <div class="p-2 rounded bg-white border border-slate-200 text-center font-medium">
              <span class="text-[10px] text-slate-400 block">Kopi</span>
              <span class="font-bold text-slate-900">Aren Latte</span>
            </div>
            <div class="p-2 rounded bg-white border border-slate-200 text-center font-medium">
              <span class="text-[10px] text-slate-400 block">Pastry</span>
              <span class="font-bold text-slate-900">Croissant</span>
            </div>
            <div class="p-2 rounded bg-amber-50 border border-amber-300 text-center font-bold text-amber-900">
              <span class="text-[10px] text-amber-700 block">Total</span>
              <span>Rp 50.000</span>
            </div>
          </div>
        </div>

        <ul class="space-y-2 mb-6">
          {
            t.pos.features.map((feature) => (
              <li class="flex items-center gap-2 text-xs sm:text-sm text-slate-700 font-medium">
                <span class="text-amber-600 font-bold">✓</span> {feature}
              </li>
            ))
          }
        </ul>
      </div>
      <a href="/onboarding" class="text-xs font-mono font-bold text-amber-700 hover:text-amber-600 flex items-center gap-1 mt-auto">
        Coba POS.Hfeit Sekarang ➔
      </a>
    </div>

    <!-- 2. BOOK.Hfeit (5 Cols - Automated General Ledger) -->
    <div class="lg:col-span-5 rounded-2xl border border-emerald-200 bg-gradient-to-b from-emerald-50/40 via-white to-white p-6 sm:p-8 shadow-sm hover:shadow-md hover:border-emerald-300 transition-all duration-200 flex flex-col justify-between">
      <div>
        <div class="flex items-center justify-between mb-4">
          <div class="flex items-center gap-2">
            <span class="px-2.5 py-1 rounded-md text-xs font-mono font-bold bg-emerald-600 text-white shadow-xs">
              02 • BOOK
            </span>
            <span class="text-xs font-mono font-bold text-emerald-800">{t.book.tagline}</span>
          </div>
          <span class="text-xs font-mono font-bold text-emerald-700 bg-emerald-100 px-2 py-0.5 rounded">
            Double-Entry
          </span>
        </div>
        <h3 class="text-2xl font-extrabold text-slate-950 mb-2">{t.book.name}</h3>
        <p class="text-xs sm:text-sm text-slate-600 mb-6 leading-relaxed font-medium">{t.book.role}</p>

        <!-- Live Ledger Ticker Widget -->
        <div class="rounded-xl border border-emerald-200 bg-emerald-50/60 p-4 mb-6 space-y-2 font-mono text-xs">
          <div class="flex items-center justify-between pb-2 border-b border-emerald-200/80">
            <span class="font-bold text-emerald-950">Jurnal Otomatis #TX-8841</span>
            <span class="text-emerald-700 font-bold">✓ Seimbang</span>
          </div>
          <div class="flex justify-between text-emerald-900 text-[11px]">
            <span>Debit: Kas Kasir 1101</span>
            <span class="font-bold">Rp 50.000</span>
          </div>
          <div class="flex justify-between text-emerald-900 text-[11px]">
            <span>Kredit: Pendapatan F&amp;B 4101</span>
            <span class="font-bold">Rp 45.455</span>
          </div>
          <div class="flex justify-between text-emerald-900 text-[11px]">
            <span>Kredit: Utang Pajak PB1 2102</span>
            <span class="font-bold">Rp 4.545</span>
          </div>
        </div>

        <ul class="space-y-2 mb-6">
          {
            t.book.features.map((feature) => (
              <li class="flex items-center gap-2 text-xs sm:text-sm text-slate-700 font-medium">
                <span class="text-emerald-600 font-bold">✓</span> {feature}
              </li>
            ))
          }
        </ul>
      </div>
      <a href="/onboarding" class="text-xs font-mono font-bold text-emerald-700 hover:text-emerald-600 flex items-center gap-1 mt-auto">
        Pelajari Pembukuan BOOK ➔
      </a>
    </div>

    <!-- 3. ORDER.Hfeit (4 Cols - 3-Way Self-Ordering) -->
    <div class="lg:col-span-4 rounded-2xl border border-rose-200 bg-gradient-to-b from-rose-50/30 via-white to-white p-6 shadow-sm hover:shadow-md hover:border-rose-300 transition-all duration-200 flex flex-col justify-between">
      <div>
        <div class="flex items-center justify-between mb-4">
          <span class="px-2.5 py-1 rounded-md text-xs font-mono font-bold bg-rose-500 text-white shadow-xs">
            03 • ORDER
          </span>
          <span class="text-xs font-mono font-bold text-rose-700">0% Komisi</span>
        </div>
        <h3 class="text-xl font-extrabold text-slate-950 mb-1">{t.order.name}</h3>
        <p class="text-xs text-slate-600 mb-4 font-medium">{t.order.role}</p>

        <!-- Smartphone QR Order Widget -->
        <div class="rounded-xl border border-slate-200 bg-slate-50 p-3 mb-4 space-y-2">
          <div class="flex items-center justify-between text-[11px] font-mono">
            <span class="font-bold text-slate-800">📱 QR Order Meja</span>
            <span class="text-rose-600 font-bold">1-Ketuk Bayar</span>
          </div>
          <div class="p-2 rounded bg-white border border-slate-200 flex items-center justify-between text-xs">
            <span class="text-slate-800 font-medium">Espresso Aren Latte</span>
            <span class="font-mono font-bold text-slate-900">Rp 28.000</span>
          </div>
        </div>

        <ul class="space-y-1.5 mb-4 text-xs text-slate-700">
          {t.order.features.map((feature) => (
            <li class="flex items-center gap-1.5">
              <span class="text-rose-600 font-bold">✓</span> {feature}
            </li>
          ))}
        </ul>
      </div>
      <a href="/onboarding" class="text-xs font-mono font-bold text-rose-700 hover:text-rose-600 flex items-center gap-1 mt-auto">
        Aktifkan QR Order ➔
      </a>
    </div>

    <!-- 4. BOARD.Hfeit (4 Cols - Edge Storefront & SEO) -->
    <div class="lg:col-span-4 rounded-2xl border border-cyan-200 bg-gradient-to-b from-cyan-50/30 via-white to-white p-6 shadow-sm hover:shadow-md hover:border-cyan-300 transition-all duration-200 flex flex-col justify-between">
      <div>
        <div class="flex items-center justify-between mb-4">
          <span class="px-2.5 py-1 rounded-md text-xs font-mono font-bold bg-cyan-600 text-white shadow-xs">
            04 • BOARD
          </span>
          <span class="text-xs font-mono font-bold text-cyan-800 bg-cyan-100 px-2 py-0.5 rounded">
            ⚡ TTFB 12ms
          </span>
        </div>
        <h3 class="text-xl font-extrabold text-slate-950 mb-1">{t.board.name}</h3>
        <p class="text-xs text-slate-600 mb-4 font-medium">{t.board.role}</p>

        <!-- Cloudflare Edge SEO Widget -->
        <div class="rounded-xl border border-cyan-200 bg-cyan-50/50 p-3 mb-4 space-y-2 font-mono text-xs">
          <div class="flex items-center justify-between text-[11px]">
            <span class="font-bold text-cyan-950">🌐 Google Rich Snippet</span>
            <span class="text-cyan-700 font-bold">⭐ 4.9 (1.4K)</span>
          </div>
          <div class="text-[11px] text-slate-600 bg-white p-2 rounded border border-cyan-200/60 truncate">
            board.hfeit.com/senopati-kopitiam
          </div>
        </div>

        <ul class="space-y-1.5 mb-4 text-xs text-slate-700">
          {t.board.features.map((feature) => (
            <li class="flex items-center gap-1.5">
              <span class="text-cyan-600 font-bold">✓</span> {feature}
            </li>
          ))}
        </ul>
      </div>
      <a href="/senopati-kopitiam" class="text-xs font-mono font-bold text-cyan-700 hover:text-cyan-600 flex items-center gap-1 mt-auto">
        Lihat Contoh BOARD ➔
      </a>
    </div>

    <!-- 5. CARD.Hfeit (4 Cols - Apple Wallet Digital Pass) -->
    <div class="lg:col-span-4 rounded-2xl border border-purple-200 bg-gradient-to-b from-purple-50/30 via-white to-white p-6 shadow-sm hover:shadow-md hover:border-purple-300 transition-all duration-200 flex flex-col justify-between">
      <div>
        <div class="flex items-center justify-between mb-4">
          <span class="px-2.5 py-1 rounded-md text-xs font-mono font-bold bg-purple-600 text-white shadow-xs">
            05 • CARD
          </span>
          <span class="text-xs font-mono font-bold text-purple-700">Apple Wallet</span>
        </div>
        <h3 class="text-xl font-extrabold text-slate-950 mb-1">{t.card.name}</h3>
        <p class="text-xs text-slate-600 mb-4 font-medium">{t.card.role}</p>

        <!-- Metallic Member Pass Widget -->
        <div class="rounded-xl border border-purple-200 bg-gradient-to-r from-purple-900 to-indigo-950 text-white p-3 mb-4 space-y-1 shadow-xs">
          <div class="flex items-center justify-between text-[11px] font-mono">
            <span class="font-bold">PASPOR GOLD VIP</span>
            <span class="text-amber-400 font-bold">👑 8/10 Stamp</span>
          </div>
          <div class="text-[10px] text-purple-200">#HFE-MBR-8841 • Senopati Kopitiam</div>
        </div>

        <ul class="space-y-1.5 mb-4 text-xs text-slate-700">
          {t.card.features.map((feature) => (
            <li class="flex items-center gap-1.5">
              <span class="text-purple-600 font-bold">✓</span> {feature}
            </li>
          ))}
        </ul>
      </div>
      <a href="/onboarding" class="text-xs font-mono font-bold text-purple-700 hover:text-purple-600 flex items-center gap-1 mt-auto">
        Buat Kartu Member ➔
      </a>
    </div>
  </div>
</section>
