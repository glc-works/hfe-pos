---
import type { ExpTranslations } from '../../i18n/translations'

interface Props {
  t: ExpTranslations['industries']
}

const { t } = Astro.props

const industries = [
  { icon: '☕', name: t.fnb.title, desc: t.fnb.desc, param: 'cafe_fnb' },
  { icon: '🛍️', name: t.retail.title, desc: t.retail.desc, param: 'retail_boutique' },
  { icon: '✂️', name: t.salon.title, desc: t.salon.desc, param: 'salon_spa' },
  { icon: '🏢', name: t.coworking.title, desc: t.coworking.desc, param: 'coworking_space' },
  { icon: '🩺', name: t.clinic.title, desc: t.clinic.desc, param: 'medical_clinic' }
]
---

<section class="py-20 px-4 sm:px-6 max-w-6xl mx-auto border-t border-white/5">
  <!-- Section Header -->
  <div class="text-center max-w-2xl mx-auto mb-12">
    <span class="text-xs font-mono text-cyan-400 uppercase tracking-wider mb-2 block">{t.sectionBadge}</span>
    <h2 class="text-3xl sm:text-4xl font-extrabold text-white mb-4">{t.sectionTitle}</h2>
  </div>

  <!-- Industry Cards Grid -->
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
    {industries.map((ind) => (
      <div class="p-5 rounded-2xl bg-slate-900/40 border border-white/10 hover:border-white/20 transition-all duration-200 flex flex-col justify-between">
        <div>
          <span class="text-3xl mb-3 block">{ind.icon}</span>
          <h3 class="text-base font-bold text-white mb-1.5">{ind.name}</h3>
          <p class="text-xs text-slate-400 leading-relaxed mb-4">{ind.desc}</p>
        </div>
        <a
          href={`/onboarding?businessType=${ind.param}`}
          class="text-xs font-mono font-bold text-amber-400 hover:text-amber-300 flex items-center gap-1 mt-auto"
        >
          Mulai Setup 60 Detik ➔
        </a>
      </div>
    ))}
  </div>
</section>
