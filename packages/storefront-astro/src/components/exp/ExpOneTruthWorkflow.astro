---
import type { ExpTranslations } from '../../i18n/translations'

interface Props {
  t: ExpTranslations['workflow']
}

const { t } = Astro.props
---

<section id="demo-section" class="py-20 px-4 sm:px-6 max-w-6xl mx-auto border-t border-white/5">
  <!-- Section Header -->
  <div class="text-center max-w-2xl mx-auto mb-16">
    <span class="text-xs font-mono text-emerald-400 uppercase tracking-wider mb-2 block">{t.sectionBadge}</span>
    <h2 class="text-3xl sm:text-4xl font-extrabold text-white mb-4">{t.sectionTitle}</h2>
    <p class="text-sm sm:text-base text-slate-400">{t.sectionSubtitle}</p>
  </div>

  <!-- Interactive Workflow Step Chain -->
  <div class="relative">
    <div class="hidden lg:block absolute top-1/2 left-0 right-0 h-0.5 bg-gradient-to-r from-rose-500 via-amber-500 to-indigo-500 -translate-y-1/2 -z-10 opacity-30"></div>
    
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-4">
      {t.steps.map((stepItem) => (
        <div class="p-5 rounded-2xl bg-slate-900/80 border border-white/10 hover:border-white/20 transition-all duration-200 flex flex-col justify-between shadow-md">
          <div>
            <div class="flex items-center justify-between mb-3">
              <span class="text-xs font-mono font-bold text-slate-500">STEP {stepItem.step}</span>
              <span class={`text-xs font-mono font-bold ${stepItem.color}`}>
                {stepItem.targetProduct}
              </span>
            </div>
            <h4 class="text-sm font-bold text-white mb-1.5">{stepItem.title}</h4>
            <p class="text-xs text-slate-400 leading-relaxed">{stepItem.desc}</p>
          </div>
          <div class="mt-4 pt-3 border-t border-white/5 flex items-center gap-1 text-[11px] font-mono text-slate-400">
            <span>⚡ Terjurnal Instan</span>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
