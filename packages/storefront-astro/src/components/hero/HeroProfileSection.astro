---
// --- MODUL 1: HERO, LIVING STATUS BAR & FASILITAS TOKO ---
import type { ResolvedMerchantProfile } from '../../lib/merchantDataResolver';

interface Props {
  profile: ResolvedMerchantProfile;
}

const { profile } = Astro.props;
---

<header class="relative w-full rounded-3xl overflow-hidden border border-slate-800 bg-slate-900/80 backdrop-blur-2xl p-4 sm:p-6 shadow-2xl">
  <!-- Ambient Glow Background -->
  <div class="absolute -top-24 -right-24 w-72 h-72 bg-amber-500/15 rounded-full blur-3xl pointer-events-none"></div>
  <div class="absolute -bottom-24 -left-24 w-72 h-72 bg-emerald-500/10 rounded-full blur-3xl pointer-events-none"></div>

  <!-- Top Brand Navigation Row (340px Mobile Strict Budget) -->
  <div class="flex items-center justify-between gap-2 pb-4 border-b border-slate-800/80 relative z-10">
    <div class="flex items-center gap-2 min-w-0">
      <div class="w-10 h-10 rounded-2xl bg-amber-500/20 border border-amber-500/40 flex items-center justify-center text-amber-400 font-bold text-lg shrink-0 shadow-inner">
        ☕
      </div>
      <div class="min-w-0">
        <div class="flex items-center gap-1.5">
          <h1 class="text-sm sm:text-base font-bold text-white truncate tracking-tight">{profile.businessName}</h1>
          <span class="inline-flex items-center px-1.5 py-0.5 rounded-full text-[9px] font-semibold bg-emerald-950/80 text-emerald-400 border border-emerald-500/30 shrink-0">
            ✓ Terverifikasi HFE
          </span>
        </div>
        <p class="text-[11px] text-slate-400 truncate">{profile.city}</p>
      </div>
    </div>

    <!-- Living Status Pill -->
    <div class="shrink-0 flex items-center gap-1.5 px-2.5 py-1 rounded-full bg-emerald-950/60 border border-emerald-500/30 text-emerald-300 text-xs font-mono font-medium">
      <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
      <span>Buka Sekarang</span>
    </div>
  </div>

  <!-- Hero Image & Story Container -->
  <div class="mt-4 grid grid-cols-1 sm:grid-cols-12 gap-4 items-center relative z-10">
    <div class="sm:col-span-7 space-y-2">
      <div class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-md bg-amber-950/40 border border-amber-500/20 text-amber-300 text-[11px] font-medium">
        ⭐ {profile.rating} ({profile.reviewCount} Ulasan Terverifikasi)
      </div>
      <h2 class="text-xl sm:text-2xl font-extrabold text-slate-100 tracking-tight leading-tight">
        {profile.tagline}
      </h2>
      <p class="text-xs sm:text-sm text-slate-300 leading-relaxed line-clamp-3">
        {profile.storyDescription}
      </p>

      <!-- Facility Badges -->
      <div class="flex flex-wrap gap-1.5 pt-2">
        {profile.facilities.map((facility) => (
          <span class="px-2 py-0.5 rounded-lg bg-slate-800/80 border border-slate-700/60 text-slate-300 text-[11px] font-mono">
            {facility}
          </span>
        ))}
      </div>
    </div>

    <div class="sm:col-span-5 aspect-[16/10] sm:aspect-square rounded-2xl overflow-hidden border border-slate-800 shadow-xl relative group">
      <img
        src={profile.heroCoverUrl}
        alt={profile.businessName}
        class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
        loading="eager"
      />
      <div class="absolute inset-0 bg-gradient-to-t from-slate-950/80 via-transparent to-transparent"></div>
      <div class="absolute bottom-2 left-2 right-2 flex items-center justify-between text-[11px] text-slate-200 font-mono bg-slate-900/70 backdrop-blur-md px-2.5 py-1 rounded-lg border border-slate-700/40">
        <span>⏰ {profile.operatingHours}</span>
      </div>
    </div>
  </div>
</header>
