---
// POS.Hfeit Interactive Early Access Request Form Section
---

<div id="early-access" class="mx-auto max-w-7xl px-6 lg:px-8 py-20">
  <div class="relative overflow-hidden bg-zinc-950 rounded-4xl p-8 sm:p-14 ring-1 ring-white/10 text-white shadow-2xl">
    <!-- Ambient Indigo Core Glow -->
    <div class="absolute -top-16 left-1/2 -translate-x-1/2 w-96 h-36 bg-indigo-600/25 blur-3xl pointer-events-none"></div>

    <div class="relative z-10 max-w-2xl mx-auto text-center">
      <div class="inline-flex items-center gap-2 rounded-full bg-white/10 px-3.5 py-1 text-xs font-semibold text-zinc-200 border border-white/10 mb-4 font-mono">
        <span>🔒</span> PROGRAM PILOT TERBATAS &bull; BATCH 01
      </div>
      <h2 class="font-display text-3xl font-extrabold sm:text-4xl text-balance">
        Ajukan Akses Awal POS.Hfeit
      </h2>
      <p class="mt-3 text-sm sm:text-base text-zinc-400 leading-relaxed">
        Kami membuka kuota terbatas untuk merchant terpilih. Isi data singkat toko Anda di bawah untuk mendapatkan undangan aktivasi resmi.
      </p>

      <!-- Interactive Early Access Form -->
      <form id="early-access-form" class="mt-8 text-left space-y-4">
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div>
            <label for="picName" class="block text-xs font-mono font-semibold text-zinc-300 mb-1.5">Nama Anda</label>
            <input 
              type="text" 
              id="picName" 
              name="picName" 
              required 
              placeholder="Contoh: Aldi Pratama" 
              class="w-full rounded-xl bg-zinc-900 border border-zinc-800 px-4 py-3 text-sm text-zinc-100 placeholder-zinc-500 focus:outline-hidden focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500"
            />
          </div>
          <div>
            <label for="storeName" class="block text-xs font-mono font-semibold text-zinc-300 mb-1.5">Nama Brand / Toko</label>
            <input 
              type="text" 
              id="storeName" 
              name="storeName" 
              required 
              placeholder="Contoh: Kopi Senopati" 
              class="w-full rounded-xl bg-zinc-900 border border-zinc-800 px-4 py-3 text-sm text-zinc-100 placeholder-zinc-500 focus:outline-hidden focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500"
            />
          </div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div>
            <label for="businessType" class="block text-xs font-mono font-semibold text-zinc-300 mb-1.5">Jenis Usaha</label>
            <select 
              id="businessType" 
              name="businessType" 
              class="w-full rounded-xl bg-zinc-900 border border-zinc-800 px-4 py-3 text-sm text-zinc-100 focus:outline-hidden focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500"
            >
              <option value="cafe">Kafe / Kedai Kopi / Bar</option>
              <option value="resto">Restoran / Rumah Makan</option>
              <option value="retail">Toko Retail / Butik</option>
              <option value="other">Lainnya</option>
            </select>
          </div>
          <div>
            <label for="branchCount" class="block text-xs font-mono font-semibold text-zinc-300 mb-1.5">Jumlah Cabang</label>
            <select 
              id="branchCount" 
              name="branchCount" 
              class="w-full rounded-xl bg-zinc-900 border border-zinc-800 px-4 py-3 text-sm text-zinc-100 focus:outline-hidden focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500"
            >
              <option value="1">1 Outlet</option>
              <option value="2-5">2 - 5 Outlet</option>
              <option value=">5">&gt; 5 Outlet (Waralaba / HQ)</option>
            </select>
          </div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div>
            <label for="whatsapp" class="block text-xs font-mono font-semibold text-zinc-300 mb-1.5">Nomor WhatsApp Aktif</label>
            <input 
              type="tel" 
              id="whatsapp" 
              name="whatsapp" 
              required 
              placeholder="081234567890" 
              class="w-full rounded-xl bg-zinc-900 border border-zinc-800 px-4 py-3 text-sm text-zinc-100 placeholder-zinc-500 focus:outline-hidden focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500 font-mono"
            />
          </div>
          <div>
            <label for="city" class="block text-xs font-mono font-semibold text-zinc-300 mb-1.5">Kota Lokasi Usaha</label>
            <input 
              type="text" 
              id="city" 
              name="city" 
              required 
              placeholder="Contoh: Jakarta Selatan" 
              class="w-full rounded-xl bg-zinc-900 border border-zinc-800 px-4 py-3 text-sm text-zinc-100 placeholder-zinc-500 focus:outline-hidden focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500"
            />
          </div>
        </div>

        <div class="pt-2">
          <button 
            type="submit" 
            id="submit-btn"
            class="w-full rounded-full bg-white hover:bg-zinc-100 text-zinc-950 py-3.5 text-sm font-bold transition shadow-xl cursor-pointer"
          >
            Kirim Permohonan Akses Awal &rsaquo;
          </button>
        </div>
      </form>

      <!-- Error State Banner (Hidden by default) -->
      <div id="error-state" class="hidden mt-6 rounded-2xl bg-rose-950/40 border border-rose-500/50 p-4 text-center">
        <p id="error-message" class="text-xs text-rose-300 font-medium leading-relaxed"></p>
      </div>

      <!-- Success State Banner (Hidden by default) -->
      <div id="success-state" class="hidden mt-8 rounded-2xl bg-zinc-900 border border-emerald-500/50 p-6 text-center">
        <div class="size-10 rounded-full bg-emerald-500/20 text-emerald-400 flex items-center justify-center mx-auto text-xl mb-3">
          ✓
        </div>
        <h3 class="text-base font-bold text-white">Permohonan Berhasil Dikirim!</h3>
        <p class="text-xs text-zinc-400 mt-1 max-w-md mx-auto leading-relaxed">
          Tim kami akan meninjau profil toko Anda dan mengirimkan link aktivasi &amp; undangan akses awal melalui WhatsApp dalam waktu 1x24 jam.
        </p>
      </div>
    </div>
  </div>
</div>

<script>
  const form = document.getElementById('early-access-form') as HTMLFormElement | null
  const successState = document.getElementById('success-state')
  const errorState = document.getElementById('error-state')
  const errorMessage = document.getElementById('error-message')
  const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement | null

  if (form && successState && submitBtn) {
    form.addEventListener('submit', async (e) => {
      e.preventDefault()
      if (errorState) errorState.classList.add('hidden')
      submitBtn.textContent = 'Memproses...'
      submitBtn.setAttribute('disabled', 'true')
      
      const formData = new FormData(form)
      const data = Object.fromEntries(formData.entries())

      try {
        const res = await fetch('/api/early-access', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(data)
        })

        const resData = await res.json().catch(() => ({ success: false, error: 'Respon server tidak valid.' }))

        if (res.ok && resData.success) {
          form.classList.add('hidden')
          if (errorState) errorState.classList.add('hidden')
          successState.classList.remove('hidden')
        } else {
          submitBtn.textContent = 'Kirim Permohonan Akses Awal ›'
          submitBtn.removeAttribute('disabled')
          if (errorState && errorMessage) {
            errorMessage.textContent = resData.error || 'Gagal mengirim permohonan. Silakan periksa kembali data Anda.'
            errorState.classList.remove('hidden')
          }
        }
      } catch (err: any) {
        submitBtn.textContent = 'Kirim Permohonan Akses Awal ›'
        submitBtn.removeAttribute('disabled')
        if (errorState && errorMessage) {
          errorMessage.textContent = 'Koneksi terputus. Pastikan perangkat Anda terhubung ke internet.'
          errorState.classList.remove('hidden')
        }
      }
    })
  }
</script>
