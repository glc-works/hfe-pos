{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hfe-pos-preview",
  "compatibility_date": "2026-08-22",

  // Custom domain lives HERE, not in a dashboard click. `wrangler deploy`
  // creates the DNS record and issues the certificate itself, so the hostname
  // this Worker answers on is reviewable in a diff and reproducible from a
  // clean checkout — which is what an evidence-bound promotion needs.
  //
  // Do NOT hand-create a proxied A record for these names. That is what the
  // other .com surfaces have, and it is why they return 525: Cloudflare is
  // pointed at an origin that completes no TLS handshake.
  //
  // Promotion to production is one more entry here (`pos.hfeit.com`), after the
  // minimum acceptance gate passes. Preview keeps serving throughout, so a
  // withdrawal is removing one line rather than an outage.
  "routes": [
    { "pattern": "prv-pos.hfeit.com", "custom_domain": true }
  ],

  // Assets-only Worker: no `main`, no server script. The app is a Vite SPA
  // (`output` is plain static `dist/`), and this repo hosts the FRONTEND only —
  // Hfe CORE and every backend service stay on AWS and are reached over REST.
  // Serving static assets from Cloudflare does not move backend ownership.
  //
  // The same shape is already in production for `hfeit.com`
  // (glc-works/hfeit-landingpage), which is why it is copied rather than
  // invented.
  "assets": {
    "directory": "./dist",

    // `single-page-application`, NOT `404-page` as the landing site uses. That
    // site is multi-page and a real 404 is the correct answer there. This app
    // routes on the client, so any path other than `/` must still return
    // index.html — with `404-page`, every deep link and every reload away from
    // the root would 404 while the app itself works perfectly in local dev.
    "not_found_handling": "single-page-application"
  }
}
