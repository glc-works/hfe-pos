{
  "$schema": "https://hfe.togrow.id/schemas/connector-manifest-v1.json",
  "name": "Hfe POS & Commerce Suite",
  "slug": "hfe-pos",
  "version": "1.0.0",
  "publisher": "GLC Works & Hfe Core Team",
  "category": "POS & Commerce",
  "icon": "🛒",
  "description": "Point of Sale & Retail Cashier Connector integrating cashier transactions, split biller fees, QRIS/VA settlement, and automated stock subledgers into Headless Company Books.",
  "permissions": [
    "accounting.post",
    "payments.process",
    "inventory.read",
    "contacts.manage",
    "subledger.post_transaction"
  ],
  "monetization": {
    "pricing_model": "transaction_fee",
    "fee_per_transaction_idr": 250,
    "revenue_share_percentage": 20
  },
  "endpoints": {
    "checkout_settle": "/v1/pos/checkout",
    "shift_reconcile": "/v1/pos/shifts/reconcile",
    "catalog_sync": "/v1/pos/products/sync",
    "settlements_multi_tender": "/v1/company-books/{book}/settlements/multi-tender"
  }
}
